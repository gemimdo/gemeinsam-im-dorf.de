# Google Cloud API key with "Google Drive API" and "Google Calendar API" enabled.
# Only used at build time – never shipped to visitors.
GOOGLE_API_KEY=

# One public Google calendar per event category. Calendar ID from
# Google Calendar → Settings → (calendar) → "Integrate calendar" (looks like ...@group.calendar.google.com).
GOOGLE_CALENDAR_FESTE=
GOOGLE_CALENDAR_FAMILIE=
GOOGLE_CALENDAR_VEREIN=

# Folder IDs: the last part of the Drive folder URL (drive.google.com/drive/folders/<ID>).
DRIVE_PHOTOS_FOLDER_ID=
DRIVE_DOCUMENTS_FOLDER_ID=
