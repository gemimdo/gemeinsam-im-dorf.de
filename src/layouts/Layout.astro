---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${site.clubName} – Termine, Fotos und Neuigkeiten aus ${site.village}.` } = Astro.props;
const fullTitle = title ? `${title} – ${site.clubName}` : site.clubName;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      // Applied before first paint so a stored dark theme never flashes light.
      try {
        const t = localStorage.getItem("dorfverein-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
