---
import LegalPage from "../../components/LegalPage.astro";
import { site } from "../../site.config";
---

<LegalPage title="Impressum">
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {site.clubName} {site.legalForm}<br />
    {site.address.street}<br />
    {site.address.zip} {site.address.city}
  </p>
  <p>Vertreten durch den 1. Vorstand, Danny Himmelreich</p>
  <h2>Registereintrag</h2>
  <p>
    Vereinsregister des Amtsgerichts Jena<br />
    Registernummer: VR231828
  </p>
  <h2>Kontakt</h2>
  <p>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a><br />Telefon: <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a></p>
  <p>[Platzhalter – der vollständige Impressumstext muss vom Verein ergänzt werden.]</p>
</LegalPage>
