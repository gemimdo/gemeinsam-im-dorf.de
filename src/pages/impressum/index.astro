---
import LegalPage from "../../components/LegalPage.astro";
import { site } from "../../site.config";
---

<LegalPage title="Impressum">
  <h2>Angaben gemäß § 5 DDG</h2>
  <p>
    {site.clubName} {site.legalForm}<br />
    {site.address.street}<br />
    {site.address.zip} {site.address.city}
  </p>
  <p>[Vertreten durch den Vorstand · Registergericht · Registernummer]</p>
  <h2>Kontakt</h2>
  <p>E-Mail: {site.email}<br />Telefon: {site.phone}</p>
  <p>[Platzhalter – der vollständige Impressumstext muss vom Verein ergänzt werden.]</p>
</LegalPage>
