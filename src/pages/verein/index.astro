---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon, { type IconName } from "../../components/Icon.astro";
import { site } from "../../site.config";

const documents = await getCollection("documents");
const membershipForm = documents.find((d) => /beitritt/i.test(d.data.title));
const membershipHref = membershipForm ? `/dokumente/dateien/${membershipForm.data.fileName}` : "/dokumente/";

const activities: { icon: IconName; title: string; text: string }[] = [
  { icon: "party", title: "Feste feiern", text: "Sommerfest, Maibaum, Weihnachtsmarkt – organisiert von vielen Händen." },
  { icon: "leaf", title: "Dorf pflegen", text: "Anger, Teich, Bänke und Spielplatz: Arbeitseinsätze zweimal im Jahr." },
  { icon: "family", title: "Kinder & Familien", text: "Bastelnachmittage, Kinderfest und der Martinsumzug." },
  { icon: "heart", title: "Nachbarschaft", text: "Willkommenspaket für Neuzugezogene und Hilfe, wenn jemand sie braucht." },
];
---

<Layout title="Verein & Dorf" description={`Wer wir sind: der Verein „${site.clubName}“ und ${site.village}.`}>
  <section class="intro-section" aria-labelledby="page-title">
    <div class="wrap intro-grid">
      <div class="intro-text">
        <p class="eyebrow with-line">Verein &amp; Dorf</p>
        <h1 id="page-title" class="display h1">Wer wir sind und wo wir leben.</h1>
        <p class="lead narrow">
          Der Verein „{site.clubName}“ ist der Treffpunkt für alle in {site.village} – Alteingesessene, Neuzugezogene, Familien und
          Feierabend-Gärtner.
        </p>
        <nav aria-label="Auf dieser Seite" class="jump">
          <a href="#verein" class="btn btn-ghost btn-sm">Der Verein</a>
          <a href="#vorstand" class="btn btn-ghost btn-sm">Vorstand</a>
          <a href="#mitglied" class="btn btn-ghost btn-sm">Mitglied werden</a>
        </nav>
      </div>
    </div>
  </section>

  <main>
    <section id="verein" class="wrap section two-col" aria-labelledby="verein-title">
      <div class="prose">
        <h2 id="verein-title" class="display h2">Der Verein</h2>
        {site.description.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <ul class="tiles">
        {
          activities.map((a) => (
            <li class="tile">
              <Icon name={a.icon} size={28} strokeWidth={1.7} />
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="vorstand" class="wrap section stack" aria-labelledby="vorstand-title">
      <h2 id="vorstand-title" class="display h2">Der Vorstand</h2>
      <ul class="tiles board">
        {
          site.board.map((person, i) => (
            <li class="tile person">
              <span class:list={["avatar", i % 2 ? "green" : "blue"]} aria-hidden="true">
                <Icon name="user" size={28} strokeWidth={1.6} />
              </span>
              <span class="person-text">
                <span class="person-name">{person.name}</span>
                <span class="person-role">{person.role}</span>
                {person.email && (
                  <a class="person-mail" href={`mailto:${person.email}`}>
                    {person.email}
                  </a>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </section>


    <section id="mitglied" class="wrap section" aria-labelledby="mitglied-title">
      <div class="join">
        <div class="join-text">
          <h2 id="mitglied-title" class="display join-title">Mitglied werden</h2>
          <p>
            Der Jahresbeitrag beträgt {site.annualFee}, ermäßigt {site.reducedFee}. Jede
            Mitgliedschaft hilft, Feste und Dorfpflege zu stemmen.
          </p>
          <ol class="steps">
            <li><span class="step">1</span><span>Beitrittserklärung herunterladen und ausfüllen</span></li>
            <li><span class="step">2</span><span>Im Briefkasten bei Himmelreich, Rockau 70 einwerfen oder per E-Mail senden</span></li>
            <li><span class="step">3</span><span>Willkommen – wir melden uns mit allen Infos</span></li>
          </ol>
          <a href={membershipHref} class="btn join-btn" download={membershipForm ? "" : undefined}>
            <Icon name="download" size={18} />Beitrittserklärung{membershipForm ? ` (${membershipForm.data.ext.toUpperCase()})` : ""}
          </a>
        </div>

        <form class="contact" aria-labelledby="form-title" data-mailto={site.email}>
          <h3 id="form-title">Oder einfach Kontakt aufnehmen</h3>
          <label>Name<input name="name" type="text" autocomplete="name" required /></label>
          <label>E-Mail<input name="email" type="email" autocomplete="email" required /></label>
          <label>Nachricht<textarea name="message" rows="4" required></textarea></label>
          <button type="submit" class="btn btn-primary">Nachricht senden</button>
          <p class="note">Öffnet Ihr E-Mail-Programm mit der fertigen Nachricht an {site.email}.</p>
        </form>
      </div>
    </section>
  </main>
</Layout>

<script>
  // No server: the form composes an e-mail in the visitor's own mail program.
  const form = document.querySelector<HTMLFormElement>("form.contact")!;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const subject = `Kontakt über die Website: ${data.get("name")}`;
    const body = `${data.get("message")}\n\n${data.get("name")}\n${data.get("email")}`;
    location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .intro-section {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .intro-grid {
    padding-top: clamp(40px, 6vw, 80px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(460px, 100%), 1fr));
    gap: 32px 48px;
    align-items: end;
  }
  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-bottom: clamp(40px, 6vw, 80px);
  }
  .narrow {
    max-width: 36ch;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 8px;
  }
  .jump .btn {
    font-size: 15px;
  }

  .two-col {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: 32px 64px;
  }
  /* Next to the long club text the tiles keep their own height instead of stretching. */
  .two-col .tiles {
    align-self: start;
  }
  .prose {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .prose p,
  .body {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 14px;
  }
  .tile {
    padding: 24px;
    border-radius: 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tile :global(svg) {
    color: var(--accent);
  }
  .tile h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 21px;
  }
  .tile p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .person {
    flex-direction: row;
    align-items: center;
    gap: 16px;
  }
  .avatar {
    flex: 0 0 auto;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar.blue {
    background: var(--soft-blue);
  }
  .avatar.green {
    background: var(--soft-green);
  }
  .avatar.green :global(svg) {
    color: var(--green);
  }
  .person-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .person-name {
    font-weight: 600;
    font-size: 17px;
  }
  .person-role {
    font-size: 14px;
    color: var(--muted);
  }
  .person-mail {
    margin-top: 2px;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .person-mail:hover {
    text-decoration: underline;
  }


  .join {
    border-radius: 32px;
    background: var(--panel);
    color: #ffffff;
    padding: clamp(28px, 5vw, 64px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 40px 64px;
    position: relative;
    overflow: hidden;
  }
  .join-text {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .join-title {
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.02;
  }
  .join-text > p {
    margin: 0;
    font-size: 18px;
    line-height: 1.65;
    color: #dce3e8;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .steps li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 16px;
    line-height: 1.5;
  }
  .steps li > span:last-child {
    padding-top: 5px;
  }
  .step {
    flex: 0 0 auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-bg);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
  }
  .join-btn {
    align-self: flex-start;
    background: var(--surface);
    color: var(--ink);
  }
  .join-btn:hover {
    background: var(--line-soft);
    color: var(--ink);
  }
  .contact {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: 24px;
    background: var(--surface);
    color: var(--ink);
  }
  .contact h3 {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
  }
  .contact label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
  }
  .contact input,
  .contact textarea {
    min-height: 48px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    font: inherit;
    font-size: 16px;
    font-weight: 400;
    color: var(--ink);
    background: var(--surface);
  }
  .contact textarea {
    padding: 12px 14px;
    resize: vertical;
  }
  .note {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
