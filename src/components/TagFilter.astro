---
// Filters every element with a data-tags JSON attribute inside `target`.
// Optional search input matches against each element's data-search text.
interface Props {
  tags: string[];
  target: string;
  search?: boolean;
}

const { tags, target, search = false } = Astro.props;
---

<div class="tag-filter" data-target={target}>
  {search && <input type="search" class="search" placeholder="Suchen …" aria-label="Suchen" />}
  {
    tags.length > 0 && (
      <div class="tags" role="group" aria-label="Nach Thema filtern">
        <button type="button" data-tag="" aria-pressed="true">Alle</button>
        {tags.map((tag) => (
          <button type="button" data-tag={tag} aria-pressed="false">
            {tag}
          </button>
        ))}
      </div>
    )
  }
</div>

<script>
  for (const filter of document.querySelectorAll<HTMLElement>(".tag-filter")) {
    const container = document.querySelector(filter.dataset.target!);
    if (!container) continue;
    const items = [...container.querySelectorAll<HTMLElement>("[data-tags]")];
    const input = filter.querySelector<HTMLInputElement>("input[type=search]");
    let activeTag = "";

    const apply = () => {
      const query = input?.value.trim().toLowerCase() ?? "";
      for (const item of items) {
        const tags: string[] = JSON.parse(item.dataset.tags!);
        const matchesTag = !activeTag || tags.includes(activeTag);
        const matchesQuery = !query || (item.dataset.search ?? "").includes(query);
        item.hidden = !(matchesTag && matchesQuery);
      }
      container.dispatchEvent(new CustomEvent("filterchange"));
    };

    filter.addEventListener("click", (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-tag]");
      if (!button) return;
      activeTag = button.dataset.tag!;
      for (const b of filter.querySelectorAll("button[data-tag]")) {
        b.setAttribute("aria-pressed", String(b === button));
      }
      apply();
    });
    input?.addEventListener("input", apply);
  }
</script>

<style>
  .tag-filter {
    margin-bottom: 1.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  button {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  button:hover {
    border-color: var(--accent);
  }
  button[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-text);
  }
</style>
