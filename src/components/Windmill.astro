---
// The club's wind turbine motif. "logo" has straight blades, "blade" the curved ones.
interface Props {
  variant?: "logo" | "blade";
  speed?: "" | "r2" | "r3";
  stroke?: string;
  strokeWidth?: number;
  class?: string;
  style?: string;
  width?: number | string;
  height?: number | string;
  x?: number;
  y?: number;
  opacity?: number;
}

const {
  variant = "blade",
  speed = "",
  stroke = "currentColor",
  strokeWidth = 2,
  class: className,
  style,
  width,
  height,
  x,
  y,
  opacity,
} = Astro.props;

const blade =
  variant === "logo" ? "M100 80 L100 8" : "M100 80 C96.5 60 96.5 32 100 4 C103.5 30 104.5 58 100 80 Z";
---

<svg
  viewBox="0 0 200 320"
  aria-hidden="true"
  fill="none"
  stroke={stroke}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  style={style}
  width={width}
  height={height}
  x={x}
  y={y}
  opacity={opacity}
>
  {
    variant === "logo" ? (
      <path d="M97 90 L92 314 L108 314 L103 90" />
    ) : (
      <>
        <path d="M97.5 88 L93 318 L107 318 L102.5 88" />
        <rect x="95" y="74" width="21" height="11" rx="4" />
      </>
    )
  }
  <g class:list={["rotor", speed]}>
    <path d={blade} />
    <path d={blade} transform="rotate(120 100 80)" />
    <path d={blade} transform="rotate(240 100 80)" />
  </g>
</svg>
