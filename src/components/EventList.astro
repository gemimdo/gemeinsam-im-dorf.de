---
import type { CollectionEntry } from "astro:content";
import { formatEventTime, formatMonth, monthKey } from "../lib/format";

interface Props {
  events: CollectionEntry<"events">[];
  groupByMonth?: boolean;
}

const { events, groupByMonth = true } = Astro.props;

const parsed = events
  .map(({ id, data }) => ({ id, ...data, start: new Date(data.start), end: new Date(data.end) }))
  .sort((a, b) => a.start.getTime() - b.start.getTime());

const groups = new Map<string, { label: string; items: typeof parsed }>();
for (const event of parsed) {
  const key = groupByMonth ? monthKey(event.start) : "all";
  if (!groups.has(key)) groups.set(key, { label: formatMonth(event.start), items: [] });
  groups.get(key)!.items.push(event);
}

const dayNumber = new Intl.DateTimeFormat("de-DE", { day: "numeric", timeZone: "Europe/Berlin" });
const weekday = new Intl.DateTimeFormat("de-DE", { weekday: "short", timeZone: "Europe/Berlin" });
---

<div class="event-list">
  {
    [...groups.values()].map((group) => (
      <section class="month" data-month>
        {groupByMonth && <h2>{group.label}</h2>}
        <ul>
          {group.items.map((event) => (
            <li class="event" data-end={event.end.toISOString()}>
              <div class="date" aria-hidden="true">
                <span class="day">{dayNumber.format(event.start)}</span>
                <span class="weekday">{weekday.format(event.start)}</span>
              </div>
              <div class="body">
                <h3>{event.title}</h3>
                <p class="meta">
                  <time datetime={event.start.toISOString()}>{formatEventTime(event)}</time>
                  {event.location && <span class="location">{event.location}</span>}
                </p>
                {event.description && (
                  <details>
                    <summary>Details</summary>
                    <p class="description">{event.description}</p>
                  </details>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <p class="empty" data-empty hidden={parsed.length > 0}>Gerade stehen keine Termine an.</p>
</div>

<script>
  // The page is built ahead of time, so hide events that ended since the last build.
  for (const list of document.querySelectorAll<HTMLElement>(".event-list")) {
    const now = Date.now();
    for (const event of list.querySelectorAll<HTMLElement>("[data-end]")) {
      if (new Date(event.dataset.end!).getTime() < now) event.hidden = true;
    }
    for (const month of list.querySelectorAll<HTMLElement>("[data-month]")) {
      month.hidden = !month.querySelector("[data-end]:not([hidden])");
    }
    const anyVisible = list.querySelector("[data-end]:not([hidden])");
    list.querySelector<HTMLElement>("[data-empty]")!.hidden = Boolean(anyVisible);
  }
</script>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .month h2 {
    font-size: 1.25rem;
    color: var(--muted);
    margin: 2rem 0 0.75rem;
  }
  .month:first-child h2 {
    margin-top: 0;
  }
  .event {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .date {
    flex: 0 0 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: calc(var(--radius) - 4px);
    padding: 0.4rem 0;
    align-self: flex-start;
  }
  .day {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .weekday {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .body {
    min-width: 0;
  }
  h3 {
    margin: 0 0 0.2rem;
    font-size: 1.15rem;
  }
  .meta {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
  }
  .location::before {
    content: "📍 ";
  }
  details {
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }
  summary {
    cursor: pointer;
    color: var(--accent);
  }
  .description {
    white-space: pre-line;
    margin: 0.4rem 0 0;
    overflow-wrap: anywhere;
  }
</style>
