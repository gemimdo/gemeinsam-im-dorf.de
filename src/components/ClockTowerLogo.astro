---
// Club logo: stylised half-timbered clock tower, from the "Uhrturm Logo" design artboard.
interface Props {
  height?: number;
}

const { height = 42 } = Astro.props;
const width = Math.round((height * 200) / 250);
---

<svg class="clock-tower" width={width} height={height} viewBox="0 0 200 250" aria-hidden="true">
  <defs>
    <clipPath id="clock-tower-cross"><rect x="70" y="132" width="60" height="52"></rect></clipPath>
  </defs>
  <g fill="none" stroke="var(--logo-ink)" stroke-width="7" stroke-linejoin="miter">
    <rect x="70" y="46" width="60" height="138"></rect>
    <line x1="70" y1="76" x2="130" y2="76"></line>
    <line x1="70" y1="132" x2="130" y2="132"></line>
    <circle cx="100" cy="104" r="14" stroke-width="6"></circle>
    <line x1="70" y1="158" x2="28" y2="190"></line>
    <line x1="130" y1="158" x2="172" y2="190"></line>
    <line x1="36" y1="184" x2="164" y2="184"></line>
    <line x1="44" y1="184" x2="44" y2="243"></line>
    <line x1="156" y1="184" x2="156" y2="243"></line>
    <line x1="24" y1="243" x2="176" y2="243"></line>
  </g>
  <g clip-path="url(#clock-tower-cross)" stroke="var(--logo-ink)" stroke-width="7">
    <line x1="70" y1="132" x2="130" y2="184"></line>
    <line x1="130" y1="132" x2="70" y2="184"></line>
  </g>
  <g stroke="var(--logo-ink)" stroke-width="3.5" stroke-linecap="round">
    <line x1="100" y1="104" x2="93" y2="98"></line>
    <line x1="100" y1="104" x2="108" y2="96"></line>
  </g>
  <polygon points="54,46 82,18 118,18 146,46" fill="var(--logo-ink)"></polygon>
  <path d="M91,73 C91,61 95,55 100,55 C105,55 109,61 109,73 Z" fill="#b5654a"></path>
  <rect x="78" y="198" width="44" height="45" fill="var(--logo-ink)"></rect>
  <!-- the door's middle gap shows the background it sits on -->
  <rect x="99" y="198" width="2" height="45" fill="var(--surface)"></rect>
</svg>

<style>
  .clock-tower {
    --logo-ink: #2b211c;
    flex: 0 0 auto;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .clock-tower {
      --logo-ink: #f4f1ea;
    }
  }
  :global(:root[data-theme="dark"]) .clock-tower {
    --logo-ink: #f4f1ea;
  }
</style>
