---
import Layout from "../layouts/Layout.astro";
import PageHeader from "./PageHeader.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<Layout title={title}>
  <PageHeader eyebrow="Rechtliches" title={title} />
  <main class="wrap legal">
    <slot />
  </main>
</Layout>

<style>
  .legal {
    padding-top: 40px;
    max-width: 760px;
    margin-inline: auto;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  .legal :global(h2) {
    font-family: var(--font-display);
    color: var(--ink);
    font-size: 24px;
    margin: 32px 0 8px;
  }
</style>
