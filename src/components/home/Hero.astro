---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import Windmill from "../Windmill.astro";
import type { EventView } from "../../lib/events";
import { MONTHS_SHORT, WEEKDAYS_SHORT, keyToUtc } from "../../lib/format";
import { site } from "../../site.config";

interface Props {
  photos: CollectionEntry<"photos">[];
  events: EventView[];
}

const { photos, events } = Astro.props;
const caption = (p: CollectionEntry<"photos">) => p.data.description ?? p.data.name;
const size = (p: CollectionEntry<"photos">) =>
  p.data.width && p.data.height ? { width: p.data.width, height: p.data.height } : { inferSize: true as const };
const multiple = photos.length > 1;
// Candidates for the "Nächster Termin" card; the script picks the first one that hasn't ended.
const nextCandidates = events.slice(0, 12);
---

<section class="hero" aria-labelledby="hero-title" data-slideshow data-interval="7000">
  <div class="layers" aria-hidden="true">
    {
      photos.length > 0 ? (
        photos.map((p, i) => (
          <div class:list={["layer", { "is-active": i === 0 }]} data-slide data-caption={caption(p)}>
            <Image
              src={p.data.src}
              {...size(p)}
              alt=""
              widths={[960, 1440, 1920, 2560]}
              sizes="100vw"
              format="webp"
              quality={75}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "auto"}
            />
          </div>
        ))
      ) : (
        <div class="layer is-active placeholder" data-slide data-caption={`Blick über ${site.village}`}>
          <svg viewBox="0 0 1440 780" preserveAspectRatio="xMidYMax slice" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M0 600 C240 540 460 552 700 590 C940 628 1160 590 1440 540" stroke="#1E6BB8" stroke-width="2" opacity="0.45" />
            <path d="M0 670 C280 624 520 640 760 664 C1000 688 1220 660 1440 640" stroke="#1E6BB8" stroke-width="2" opacity="0.3" />
            <path d="M0 730 C300 700 600 712 880 724 C1100 734 1300 720 1440 714" stroke="#1E6BB8" stroke-width="2" opacity="0.18" />
            <Windmill x={1080} y={150} width={280} height={448} stroke="#1E6BB8" strokeWidth={1.4} />
            <Windmill x={860} y={330} width={160} height={256} stroke="#1E6BB8" strokeWidth={1.8} opacity={0.6} speed="r2" />
            <Windmill x={720} y={420} width={100} height={160} stroke="#1E6BB8" strokeWidth={2.4} opacity={0.4} speed="r3" />
          </svg>
        </div>
      )
    }
  </div>

  <div class="wrap content">
    <div class="card">
      <Windmill class="card-mill" stroke="#1E6BB8" speed="r2" />
      <p class="eyebrow with-line">Dorfverein seit {site.founded}</p>
      <h1 id="hero-title" class="display title">
        Gemeinsam <span class="accent">Rückenwind</span> für {site.village}.
      </h1>
      <p class="intro">
        Wir feiern Feste, packen bei Arbeitseinsätzen mit an und halten zusammen, was unser Dorf lebendig macht.
        Mitmachen kann jede und jeder.
      </p>
      <div class="actions">
        <a href="#termine" class="btn btn-primary">Termine ansehen <Icon name="arrow-right" size={18} /></a>
        <a href="/verein/" class="btn btn-ghost">Über den Verein</a>
      </div>
      {
        nextCandidates.map((e) => {
          const d = keyToUtc(e.firstDay);
          return (
            <a href="#termine" class="next" data-next-event data-end={e.end} hidden>
              <span class="next-date">
                <span class="next-day">{d.getUTCDate()}</span>
                <span class="next-mon">{MONTHS_SHORT[d.getUTCMonth()]}</span>
              </span>
              <span class="next-text">
                <span class="next-meta">
                  Nächster Termin · {WEEKDAYS_SHORT[d.getUTCDay()]}, {e.timeLabel}
                </span>
                <span class="next-title">{e.title}</span>
              </span>
            </a>
          );
        })
      }
    </div>

    {
      multiple && (
        <div class="controls-col">
          <span class="caption-pill">
            <strong data-slide-caption>{caption(photos[0])}</strong>
          </span>
          <div class="controls" role="group" aria-label="Diashow steuern">
            <button type="button" class="ctl" data-slide-toggle aria-label="Diashow pausieren">
              <svg class="i-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="6" y="5" width="4" height="14" rx="1" />
                <rect x="14" y="5" width="4" height="14" rx="1" />
              </svg>
              <svg class="i-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5l11 7-11 7z" />
              </svg>
            </button>
            <button type="button" class="ctl" data-slide-prev aria-label="Vorheriges Bild">
              <Icon name="chevron-left" />
            </button>
            <div class="bars">
              {photos.map((p, i) => (
                <button type="button" class="bar" data-slide-to={i} aria-label={`Bild ${i + 1}: ${caption(p)}`}>
                  <span />
                </button>
              ))}
            </div>
            <button type="button" class="ctl" data-slide-next aria-label="Nächstes Bild">
              <Icon name="chevron-right" />
            </button>
          </div>
        </div>
      )
    }
  </div>
</section>

<script>
  import { initSlideshows } from "../../scripts/slideshow";
  initSlideshows();
  const now = Date.now();
  const next = [...document.querySelectorAll<HTMLElement>("[data-next-event]")].find(
    (el) => new Date(el.dataset.end!).getTime() >= now,
  );
  if (next) next.hidden = false;
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: #dce6ee;
    min-height: clamp(600px, 60vw, 780px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .layers {
    position: absolute;
    inset: 0;
  }
  .layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1);
    transition:
      opacity 1.2s ease,
      transform 9s ease-out;
  }
  .layer.is-active {
    opacity: 1;
    transform: scale(1.06);
  }
  .layer.placeholder {
    background: #d3e4f3;
  }
  .layer :global(img),
  .layer svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: reduce) {
    .layer,
    .layer.is-active {
      transform: none;
      transition: opacity 0.4s ease;
    }
  }
  .content {
    position: relative;
    width: 100%;
    padding-top: clamp(96px, 12vw, 160px);
    padding-bottom: clamp(20px, 3.5vw, 44px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .card {
    flex: 0 1 640px;
    min-width: 0;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .card :global(.card-mill) {
    position: absolute;
    right: -18px;
    top: -26px;
    height: 150px;
    width: auto;
    opacity: 0.16;
  }
  .title {
    font-size: clamp(40px, 5.2vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }
  .accent {
    color: var(--accent);
  }
  .intro {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .actions .btn {
    padding: 0 24px;
  }
  .next {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px 12px 12px;
    border-radius: 16px;
    background: var(--bg);
    border: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
  }
  .next:hover {
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .next-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    line-height: 1;
  }
  .next-day {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
  }
  .next-mon {
    font-size: 12px;
    color: var(--muted);
    margin-top: 3px;
  }
  .next-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .next-meta {
    font-size: 13px;
    color: var(--muted);
  }
  .next-title {
    font-weight: 600;
    font-size: 16px;
  }
  .controls-col {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .caption-pill {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 14px;
    color: var(--ink);
  }
  .caption-pill strong {
    font-weight: 600;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--surface);
  }
  .ctl {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--ink);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .ctl:hover {
    background: var(--line-soft);
  }
  [data-slide-toggle][aria-pressed="false"] .i-play,
  [data-slide-toggle][aria-pressed="true"] .i-pause {
    display: none;
  }
  .bars {
    display: flex;
    align-items: center;
  }
  .bar {
    width: 34px;
    height: 44px;
    border: 0;
    padding: 0 4px;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .bar span {
    display: block;
    width: 100%;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
  }
  .bar[aria-current="true"] span {
    background: var(--accent);
  }
</style>
